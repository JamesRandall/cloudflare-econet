// The official service, at econet.acornplayground.org. Same code as a
// self-hosted one (../econet), with its own name and domain.
//
//   cd ../econet && npx wrangler deploy --config ../deploy/wrangler.production.jsonc
{
  "$schema": "../econet/node_modules/wrangler/config-schema.json",
  "name": "acorn-internet-econet-production",
  "main": "../econet/src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "econet.acornplayground.org", "custom_domain": true }],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "CODES", "class_name": "CodeIndexDurableObject" },
      { "name": "LIMITS", "class_name": "RateLimiterDurableObject" },
      { "name": "SCREENS", "class_name": "ScreensDurableObject" },
      { "name": "METRICS", "class_name": "MetricsDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject", "CodeIndexDurableObject", "RateLimiterDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ScreensDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["MetricsDurableObject"] }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://econet.acornplayground.org",
    "SERVICE_NAME": "Acorn Playground Econet",
    "SOURCE_URL": "https://github.com/JamesRandall/cloudflare-econet",
    "ROOM_CREATION": "open",
    "MAX_ACTIVE_ROOMS": "500",
    "INVITE_TTL_HOURS": "24",
    "ROOM_MESSAGES_PER_SECOND": "2000",
    "ROOM_BYTES_PER_SECOND": "1048576"
  }
}
