// A self-hostable configuration: deploys to your workers.dev subdomain as
// it is. (The official service's own configuration, with its custom
// domain, is kept with the deployment, not here.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acorn-internet-econet",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "CODES", "class_name": "CodeIndexDurableObject" },
      { "name": "LIMITS", "class_name": "RateLimiterDurableObject" },
      { "name": "SCREENS", "class_name": "ScreensDurableObject" },
      { "name": "METRICS", "class_name": "MetricsDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject", "CodeIndexDurableObject", "RateLimiterDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ScreensDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["MetricsDurableObject"] }
  ],
  "vars": {
    // Shown to people joining, and in invitation links. Leave empty to use
    // the request's own origin.
    "PUBLIC_ORIGIN": "",
    "SERVICE_NAME": "Acorn Internet Econet",
    // Operator settings (empty: the defaults). "closed" stops new rooms.
    "ROOM_CREATION": "open",
    // The most rooms active at once (empty: no limit).
    "MAX_ACTIVE_ROOMS": "",
    // How long a new invitation lasts, in hours (default 24).
    "INVITE_TTL_HOURS": "",
    // A whole room's traffic, across all its members (defaults 2000, 1048576).
    "ROOM_MESSAGES_PER_SECOND": "",
    "ROOM_BYTES_PER_SECOND": ""
    // The admin endpoints need a secret: `npx wrangler secret put ADMIN_TOKEN`.
  }
}
